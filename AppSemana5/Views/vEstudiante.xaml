<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppSemana5.Models"
             x:Class="AppSemana5.Views.vEstudiante"
             Title="Semana 5 App">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12"
          Padding="16">

        <!-- Formulario para ingresar -->
        <Entry x:Name="txtNombre"
               Grid.Row="0"
               Placeholder="Nombre del estudiante"
               MaxLength="100"
               ReturnType="Done"
               Completed="OnAgregarClicked"
               SemanticProperties.Hint="Escribe el nombre del estudiante" />

        <Button Grid.Row="1"
                Text="Agregar"
                Clicked="OnAgregarClicked" />

        <Label x:Name="lblMensaje"
               Grid.Row="2"
               IsVisible="False"
               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />

        <!-- Lista de estudiantes guardados -->
        <CollectionView x:Name="lstEstudiantes"
                        Grid.Row="3">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay estudiantes. Agrega el primero arriba."
                       HorizontalTextAlignment="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Estudiante">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Padding="0,8">
                        <Label Text="{Binding Nombre}"
                               FontSize="16"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Button Grid.Column="1"
                                Text="Eliminar"
                                Clicked="OnEliminarClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
