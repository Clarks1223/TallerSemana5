<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppSemana5.Models"
             x:Class="AppSemana5.Views.vEstudiante"
             Title="Semana 5 App">

    <ContentPage.Resources>
        <!-- Color de las líneas de la tabla: se dibujan dejando 1 px de separación
             entre celdas sobre un fondo de este color. -->
        <Color x:Key="LineaTabla">#9E9E9E</Color>

        <Style x:Key="Celda" TargetType="Label">
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        </Style>

        <Style x:Key="Encabezado" TargetType="Label" BasedOn="{StaticResource Celda}">
            <Setter Property="BackgroundColor" Value="#FFEB3B" />
            <Setter Property="TextColor" Value="{StaticResource Black}" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12"
          Padding="16">

        <Button Grid.Row="0"
                Text="Agregar estudiante"
                Clicked="OnAgregarClicked" />

        <Label Grid.Row="1"
               Text="Toca un estudiante para actualizarlo o eliminarlo." />

        <Label x:Name="lblMensaje"
               Grid.Row="2"
               IsVisible="False"
               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />

        <!-- Tabla: encabezado + filas -->
        <Grid Grid.Row="3"
              RowDefinitions="Auto,*">

            <Grid ColumnDefinitions="80,*,*,60"
                  ColumnSpacing="1"
                  Padding="1"
                  BackgroundColor="{StaticResource LineaTabla}">
                <Label Grid.Column="0" Text="Código" Style="{StaticResource Encabezado}" />
                <Label Grid.Column="1" Text="Nombre" Style="{StaticResource Encabezado}" />
                <Label Grid.Column="2" Text="Apellido" Style="{StaticResource Encabezado}" />
                <Label Grid.Column="3" Text="Edad" Style="{StaticResource Encabezado}" />
            </Grid>

            <CollectionView x:Name="lstEstudiantes"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnEstudianteSeleccionado">
                <CollectionView.EmptyView>
                    <Label Text="No hay estudiantes registrados."
                           HorizontalTextAlignment="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Estudiante">
                        <Grid ColumnDefinitions="80,*,*,60"
                              ColumnSpacing="1"
                              Padding="1,0,1,1"
                              BackgroundColor="{StaticResource LineaTabla}">
                            <Label Grid.Column="0"
                                   Text="{Binding Codigo}"
                                   HorizontalTextAlignment="End"
                                   Style="{StaticResource Celda}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Nombre}"
                                   Style="{StaticResource Celda}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Apellido}"
                                   Style="{StaticResource Celda}" />
                            <Label Grid.Column="3"
                                   Text="{Binding Edad}"
                                   HorizontalTextAlignment="End"
                                   Style="{StaticResource Celda}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
