<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppSemana5.Models"
             x:Class="AppSemana5.Views.vEstudiante"
             Title="Semana 5 App">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12"
          Padding="16">

        <!-- Formulario para ingresar o editar -->
        <Entry x:Name="txtNombre"
               Grid.Row="0"
               Placeholder="Nombre del estudiante"
               MaxLength="100"
               ReturnType="Done"
               Completed="OnGuardarClicked"
               SemanticProperties.Hint="Escribe el nombre del estudiante" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <Button x:Name="btnGuardar"
                    Text="Agregar"
                    Clicked="OnGuardarClicked" />
            <Button x:Name="btnCancelar"
                    Grid.Column="1"
                    Text="Cancelar"
                    IsVisible="False"
                    Clicked="OnCancelarClicked" />
        </Grid>

        <Label x:Name="lblMensaje"
               Grid.Row="2"
               IsVisible="False"
               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />

        <!-- Lista de estudiantes guardados -->
        <CollectionView x:Name="lstEstudiantes"
                        Grid.Row="3">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay estudiantes. Agrega el primero arriba."
                       HorizontalTextAlignment="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Estudiante">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Padding="0,8">
                        <Label Text="{Binding Nombre}"
                               FontSize="16"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Button Grid.Column="1"
                                Text="Editar"
                                Clicked="OnEditarClicked" />
                        <Button Grid.Column="2"
                                Text="Eliminar"
                                Clicked="OnEliminarClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
