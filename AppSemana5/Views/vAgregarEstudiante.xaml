<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSemana5.Views.vAgregarEstudiante"
             Title="Agregar estudiante">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="8">

            <Label Text="Nombre" />
            <Entry x:Name="txtNombre"
                   Placeholder="Nombre"
                   MaxLength="50"
                   ReturnType="Next" />

            <Label Text="Apellido" />
            <Entry x:Name="txtApellido"
                   Placeholder="Apellido"
                   MaxLength="50"
                   ReturnType="Next" />

            <Label Text="Edad" />
            <Entry x:Name="txtEdad"
                   Placeholder="Edad"
                   Keyboard="Numeric"
                   MaxLength="3"
                   ReturnType="Done"
                   Completed="OnAgregarClicked" />

            <Label x:Name="lblMensaje"
                   IsVisible="False"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Margin="0,8,0,0">
                <Button Text="Agregar"
                        Clicked="OnAgregarClicked" />
                <Button Grid.Column="1"
                        Text="Cancelar"
                        Clicked="OnCancelarClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
